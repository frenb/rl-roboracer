# Environment variable template for the rl-roboracer stack.
#
# Copy this file to `.env` (which is git-ignored) and fill in the real
# values for your local setup. Docker Compose automatically reads .env
# in the same directory as docker-compose.yml when running `docker
# compose up`.
#
# Sections:
#   1. Trainer / Mongo (existing - already implicit defaults in compose)
#   2. MadScientist agent (NEW - added 2026-05-25)


# =============================================================
# 1. Trainer / Mongo
# =============================================================
# The compose file's `${VAR:-default}` syntax means these all have safe
# defaults; only override if you've changed the Mongo password or are
# running against a remote Mongo.

# MONGO_URL=mongodb://root:example@mongo:27017/


# =============================================================
# 2. MadScientist agent
# =============================================================
# All variables below feed the `madscientist` service in docker-compose.yml.
# See docker/madscientist/Dockerfile + entrypoint.sh + the comments in
# rl_agent/madscientist/{constants.py,main.py} for what each one does.

# ---- Worker gating -----------------------------------------------------
# The MASTER kill switch. Default is "false" so bringing up the stack
# never accidentally costs money. Flip to "true" + `docker compose
# restart madscientist` once Phase 1 ships and you're ready to run
# proposals.
MADSCIENTIST_ENABLED=false


# ---- LLM API keys (REQUIRED when MADSCIENTIST_ENABLED=true) ------------
# Anthropic key powers both the MadScientist researcher and the Judge.
# Get one from https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Cursor key powers the implementation orchestrator. Get one from
# https://cursor.com/settings -> API keys. Used by @cursor/sdk to spawn
# agents in /worktrees/<proposal-id>/ that author the code changes +
# open the PR + queue the TRAIN jobs.
CURSOR_API_KEY=


# ---- Email bridge ------------------------------------------------------
# Outbound proposal notifications use SMTP. For Gmail, use port 587 with
# an App Password (NOT your account password):
#   https://support.google.com/accounts/answer/185833
# For other providers, change SMTP_HOST + SMTP_PORT accordingly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The email address where proposal notifications + outcome summaries
# arrive. The MadScientist's "From:" is the same as SMTP_USER unless
# you specify otherwise in Phase 1's email_bridge.py.
NOTIFICATION_EMAIL=

# Inbound reply parsing uses the Gmail API with a Pub/Sub push
# subscription (cleaner than IMAP polling, free-tier OK). One-time
# setup:
#   1. Create a Google Cloud project; enable the Gmail API + Pub/Sub API.
#   2. Create OAuth credentials, download the client_secret.json.
#   3. Place it at ./secrets/gmail_oauth.json on the host.
#   4. Run the Phase 1 OAuth dance (a one-time CLI command) to populate
#      ./secrets/gmail_oauth.json with the refresh token.
# GMAIL_OAUTH_CREDS_PATH=/secrets/gmail_oauth.json

# ---- Magic-link decision buttons --------------------------------------
# The proposal notification email carries Approve / Reject / Defer
# buttons that hit GET /madscientist/act on the dashboard. The dashboard
# serves HTTP routes on port 80 (port 8080 is the WebSocket server -
# pointing links there returns "426 Upgrade Required"). These links need
# a base URL reachable from wherever you open email:
#   * http://localhost works only on this host (phone clicks won't work).
#   * Set a LAN IP (e.g. http://192.168.1.50) for same-Wi-Fi phones.
#   * Set a Tailscale / Cloudflare-tunnel / ngrok URL for anywhere.
DASHBOARD_PUBLIC_URL=http://localhost
# HMAC secret that signs (madscientist) + verifies (dashboard) the
# one-click decision tokens. Both services must read the SAME value.
# Leave empty to disable buttons (email sends with a dashboard link
# only). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MADSCIENTIST_TOKEN_SECRET=
# How often the email bridge checks for new pending proposals (seconds).
NOTIFY_POLL_INTERVAL_SECONDS=60
# Magic-link validity window in seconds (default 7 days). After this the
# link expires and the operator must decide from the dashboard.
DECISION_TOKEN_TTL_SECONDS=604800


# ---- Safety / budget knobs --------------------------------------------
# Conservative defaults so first weeks of running don't surprise-bill.
# Observe the spend gauge on the dashboard's Mad Scientist Lab tab and
# tune from here.

# Hard limit on how many proposals the researcher can submit per 24h.
# At full $250/mo budget, ~1/day is roughly the break-even rate.
MAX_PROPOSALS_PER_DAY=1

# Soft monthly budget. The worker refuses new cycles when this is
# exceeded; manual top-up requires editing this value + restart.
BUDGET_USD_PER_MONTH=250

# How long the researcher sleeps between cycles (6h default = 4
# attempts per day, gated by MAX_PROPOSALS_PER_DAY).
RESEARCH_CYCLE_INTERVAL_SECONDS=21600

# How often the outcome ingester checks whether a proposal's linked
# TRAIN jobs all reached DONE (5min default).
OUTCOME_POLL_INTERVAL_SECONDS=300

# Pending proposals auto-reject if you don't respond within this window.
# Keeps the queue clean if you're on vacation; flip to 0 to disable.
AUTO_REJECT_AFTER_HOURS=96
