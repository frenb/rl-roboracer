  "reward_designs": [
    {
      "_id": {
        "$oid": "6a3350e52ddfadd149b0db2f"
      },
      "name": "Goal-count speed (v4, TIME_COST 0.0073)",
      "description": "v3 goal-count with TIME_COST=0.0073, calibrated so a dawdling episode (~42 goals over 3000 steps / ~71 steps-per-goal) breaks even at 0, while the real productive agent (~21 steps/goal) scores strongly positive. Restores best-model selection. GOAL_BONUS=1.0, CRASH_PENALTY=-1.0.",
      "code": "\"\"\"Goal-count speed reward (v4, TIME_COST 0.0073) + per-episode logging.\n\nLogs each episode's reward decomposition on termination so the calibration is\nexact: goals, goal-bonus sum, time-cost sum, crash, total. This sum matches the\ntf-agents undiscounted AverageReturn, letting us reconcile the eval numbers.\n\nTune: GOAL_BONUS, TIME_COST, CRASH_PENALTY, QUICKNESS_REF.\n\"\"\"\n\nGOAL_BONUS = 1.0\nTIME_COST = 0.0073\nCRASH_PENALTY = -1.0\nQUICKNESS_REF = 100.0\n\n_state = {\"verified\": False, \"goals\": 0, \"goal_bonus_sum\": 0.0,\n          \"time_cost_sum\": 0.0, \"steps\": 0}\n\n\ndef reward_standard(data, data_arr, step_costs, *, defaults, course):\n    r = -TIME_COST\n    _state[\"time_cost_sum\"] += TIME_COST\n    _state[\"steps\"] += 1\n    if not _state.get(\"verified\"):\n        _state[\"verified\"] = True\n        speed = data.get(\"car\", {}).get(\"speed\")\n        print(f\"[goal-count-v4 VERIFY] first reward_standard: speed={speed} \"\n              f\"reward={r:+.4f} GOAL_BONUS={GOAL_BONUS} TIME_COST={TIME_COST} \"\n              f\"CRASH_PENALTY={CRASH_PENALTY}\", flush=True)\n    return r\n\n\ndef reward_success(data, data_arr, step_costs, position_history, *, defaults, course):\n    try:\n        steps = course.steps_since_last_goal\n    except Exception:\n        steps = 0\n    if steps is None:\n        steps = 0\n    quickness = max(0.0, 1.0 - float(steps) / QUICKNESS_REF)\n    bonus = GOAL_BONUS * (0.5 + 0.5 * quickness)\n    _state[\"goals\"] += 1\n    _state[\"goal_bonus_sum\"] += bonus\n    _state[\"steps\"] += 1\n    return bonus\n\n\ndef reward_failure(data, data_arr, step_costs, position_history, *, defaults, course):\n    _state[\"steps\"] += 1\n    total = _state[\"goal_bonus_sum\"] - _state[\"time_cost_sum\"] + CRASH_PENALTY\n    print(f\"[goal-count-v4 EPISODE] goals={_state['goals']} \"\n          f\"goal_bonus_sum={_state['goal_bonus_sum']:.3f} \"\n          f\"time_cost_sum=-{_state['time_cost_sum']:.3f} \"\n          f\"crash={CRASH_PENALTY:.3f} steps={_state['steps']} \"\n          f\"total={total:.3f}\", flush=True)\n    _state[\"goals\"] = 0\n    _state[\"goal_bonus_sum\"] = 0.0\n    _state[\"time_cost_sum\"] = 0.0\n    _state[\"steps\"] = 0\n    return CRASH_PENALTY\n",
      "author": "cursor-agent",
      "archived": false,
      "version": {
        "$numberInt": "3"
      },
      "created_at": {
        "$date": {
          "$numberLong": "1781747941582"
        }
      },
      "updated_at": {
        "$date": {
          "$numberLong": "1781747941582"
        }
      }
    }
